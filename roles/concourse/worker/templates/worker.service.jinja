# {{ ansible_managed }}

[Unit]
Description=Concourse Worker
Documentation=https://concourse-ci.org/docs/
After=network.target network-online.target
Requires=network-online.target tailscaled.service
StartLimitIntervalSec=900
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/default/{{ concourse_worker_service_name }}
ExecStart={{ concourse_worker_usr_path }}/bin/concourse worker
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartKillSignal=SIGUSR1
RestartSec=5
KillSignal=SIGUSR2
TimeoutStopSec=300
SendSIGKILL=yes

[Install]
WantedBy=default.target
