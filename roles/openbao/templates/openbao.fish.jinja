# {{ ansible_managed }}

set -Ux BAO_ADDR "https://[{{ (ansible_facts.tailscale0.ipv6 | selectattr('scope', 'eq', 'global') | list | first).address }}]:8200"
set -Ux BAO_CAPATH "{{ ca_root_path }}/{{ ca_root_file }}"
set -Ux BAO_CLIENT_CERT "{{ openbao_var_path }}/certs/server.crt"
set -Ux BAO_CLIENT_KEY "{{ openbao_var_path }}/certs/server.key"
