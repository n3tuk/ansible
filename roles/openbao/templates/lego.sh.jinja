#!/usr/bin/env bash
# {{ ansible_managed }}

set -euo pipefail

# Ensure required environment variables are set
: "${LEGO_HOOK_CERT_PATH:?LEGO_HOOK_CERT_PATH must be set}"
: "${LEGO_HOOK_CERT_KEY_PATH:?LEGO_HOOK_CERT_KEY_PATH must be set}"

# Check if certificate files exist
if [[ ! -f "${LEGO_HOOK_CERT_PATH}" || ! -f "${LEGO_HOOK_CERT_KEY_PATH}" ]]; then
  echo "$(date +'%Y/%m/%d %H:%M:%S') [ERROR] Certificate files not found. Cannot continue." >&2
  exit 1
fi

for cert in \
  "${LEGO_HOOK_CERT_PATH}={{ openbao_var_path }}/certs/server.crt" \
  "${LEGO_HOOK_CERT_KEY_PATH}={{ openbao_var_path }}/certs/server.key"; do
  tmp="${cert/*=/}.tmp.$$"

  echo "$(date +'%Y/%m/%d %H:%M:%S') [INFO] Copying ${cert/=*/} to ${cert/*=/} (via ${tmp})"

  cp "${cert/=*/}" "${tmp}"
  chown "{{ openbao_service_user }}:{{ caddy_group }}" "${tmp}"
  chmod 0640 "${tmp}"
  mv -f "${tmp}" "${cert/*=/}"
done

if systemctl is-active --quiet "{{ openbao_service_name }}.service"; then
  echo "$(date +'%Y/%m/%d %H:%M:%S') [INFO] Reloading the OpenBao service ({{ openbao_service_name }}.service)"
  systemctl reload "{{ openbao_service_name }}.service"
fi

if systemctl is-active --quiet "{{ caddy_service_name }}.service"; then
  echo "$(date +'%Y/%m/%d %H:%M:%S') [INFO] Reloading the Caddy service ({{ caddy_service_name }}.service)"
  systemctl reload "{{ caddy_service_name }}.service"
fi
